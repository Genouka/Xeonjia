#: assets/maps/story/30_cityhall.tmx:
#, fuzzy
msgid "Sure, I'll be careful."
msgstr "Tabii, dikkatli olacağım."

#: assets/maps/story/30_cityhall.tmx:
#, fuzzy
msgid "Thank you again.\nI wish you a good journey, come back anytime."
msgstr "Tekrar teşekkürler.\nİyi yolculuklar dilerim, istediğin zaman geri gelebilirsin."

#: assets/maps/story/30_cityhall.tmx:
#, fuzzy
