        (&quot;/&quot; &quot;Yep, it won't be easy but I want to visit the whole Kingdom!\nAnd maybe even visit places outside the Kingdom!&quot;)
        (&quot;/hero_surprised&quot; &quot;Are there places outside the Kingdom?!&quot;)
        (&quot;/&quot; &quot;Dunno, that's what I want to find out!&quot;)
        (&quot;/_happy&quot; &quot;Anyway, I don't want to waste any more of your time.&quot;)
        (&quot;/&quot; &quot;After all, you have to save the world. Not an easy task!&quot;)
        (&quot;/&quot; &quot;I'm sure we'll meet again soon, hero.&quot;)
        (&quot;/_happy&quot; &quot;See ya!&quot;)
        (&quot;/hero_happy&quot; &quot;Bye Milla!&quot;)))
