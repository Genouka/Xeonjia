   <properties>
    <property name="action">(begin 
    (dialog
        '((&quot;…&quot;)
        (&quot;???/&quot; &quot;Oops… yes, sorry, I am in the middle of the road…\nAre you a tourist? There are very few nowadays.&quot;)
