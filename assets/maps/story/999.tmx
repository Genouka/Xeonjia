   <properties>
    <property name="action">(if (!get &quot;999-talk-milla&quot;)
    (begin
        (set &quot;999-talk-milla&quot; #t)
        (dialog
            '((&quot;/hero&quot; &quot;Hi Milla, are you ok? Did you get here without any problems?&quot;)
            (&quot;/_happy&quot; &quot;Hii {{hero}}!&quot;)
            (&quot;/&quot; &quot;Yes, I cleverly managed to avoid the monsters that were along the way!&quot;)
            (&quot;/_happy&quot; &quot;I love those cute little green worms!&quot;)
            (&quot;/hero_mouthless&quot; &quot;…S-such weird tastes here.&quot;)
            (&quot;/_sad&quot; &quot;Unkind!&quot;)
            (&quot;/&quot; &quot;Aaanyway, look here! This is the tower where the King of Evil resides!&quot;)
            (&quot;/hero&quot; &quot;Oh really? Are we there yet?&quot;)
            (&quot;/&quot; &quot;It seems so… but it's closed!\nThis nice gentleman here explained to me that to access the tower you need to have 3 signets.&quot;)
            (&quot;/hero&quot; &quot;Signets?&quot;)
            (&quot;/&quot; &quot;I did not understand exactly what they are, but if I have not misunderstood they are kept in crypts present in each region of the Kingdom.&quot;)
            (&quot;/hero&quot; &quot;Mm… Then I really think that I have to set out in search of these crypts…&quot;)
            (&quot;/&quot; &quot;I guess you have no other choice.&quot;)
            (&quot;/_happy&quot; &quot;Good luck!&quot;)))
        (fire-global-event))
    (dialog '((&quot;/&quot; &quot;Do your best!&quot;))))</property>
    <property name="actionOnEvent">(if (get &quot;022-tower1-ok&quot;)
    (delete))</property>
