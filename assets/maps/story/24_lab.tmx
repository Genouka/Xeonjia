  <object id="71" class="NPC" gid="18" x="128" y="64" width="16" height="16">
   <properties>
    <property name="action" value="(dialog '((&quot;scientist&quot; &quot;Sorry about the mess. Thieves have entered and turned everything upside down.&quot;)))"/>
    <property name="orientation" type="int" value="1"/>
    <property name="quiet" type="bool" value="true"/>
   </properties>
  </object>
  <object id="73" class="NPC" gid="22" x="32" y="112" width="16" height="16">
   <properties>
    <property name="action">(begin
  (dialog '((&quot;scientist/_sad&quot; &quot;A life's work has been destroyed…&quot;)))
  (if (get &quot;the-end&quot;)
    (dialog '((&quot;/&quot; &quot;Again.&quot;)))))</property>
   </properties>
  </object>
  <object id="78" gid="285" x="80" y="96" width="16" height="16">
   <properties>
    <property name="action">(begin
  (define id &quot;24-shen-stones&quot;)
  (if (!get id)
    (begin
      (dialog '((&quot;/&quot; &quot;{{hero}}!\nThieves broke in again 2 days ago.\nWhat's up?\nHave you decided to look for the stones?&quot;)))
      (answer id '((&quot;Yes&quot; . #t) (&quot;No&quot; . #f)))
      (wait)
      (if (get id)
        (dialog '((&quot;/&quot; &quot;Great!&quot;)))
        (dialog '((&quot;/&quot; &quot;Wise choice! Live your life!&quot;))))
      (wait)))
  (if (get &quot;24-shen-stones&quot;)
    (if (not (has-item &quot;2.stone&quot;))
      (dialog '((&quot;/&quot; &quot;From my research, I think a stone is in an area close to your home.&quot;)))
      (if (not (has-item &quot;39.stone2&quot;))
        (dialog '((&quot;/&quot; &quot;A stone may be near where you and September fought long ago.&quot;)))
        (if (not (has-item &quot;71.stone3&quot;))
          (dialog '((&quot;/&quot; &quot;Another stone might be found near the volcano.&quot;)))
          (if (not (has-item &quot;x1.stone4&quot;))
            (dialog '((&quot;/&quot; &quot;Xeonjia Tower. I would go there to look for a stone.&quot;)))
            (if (not (has-item &quot;24.stone5&quot;))
              (dialog '((&quot;/&quot; &quot;I think a stone is still missing but I don't know where it is.\nI've heard strange tales related to the Mitsu Forest.&quot;)))
              (if (!get &quot;game-completed&quot;)
                (dialog '((&quot;/&quot; &quot;Do you have all the stones?! Congratulations!\nThere is someone waiting for you in the Mitsu Forest.&quot;)))
                (if (!get &quot;game-completed-shen&quot;)
                  (begin
                    (set &quot;game-completed-shen&quot; #t)
                    (dialog
                      '((&quot;/&quot; &quot;So you finished this challenge too, huh?\nBravo.&quot;)
                      (&quot;/hero&quot; &quot;Did you organize this treasure hunt? Right?&quot;)
                      (&quot;/&quot; &quot;Yes… I placed the stones…\nI did it to give you something to do.&quot;)
                      (&quot;/hero_happy&quot; &quot;Thank you Shen, I enjoyed it!&quot;)
                      (&quot;/&quot; &quot;This makes me happy!\nBut now we're really done.&quot;)
                      (&quot;/&quot; &quot;Have a nice life, {{hero}}.&quot;))))
                  (dialog '((&quot;/&quot; &quot;Have a nice life, {{hero}}.&quot;))))))))))))</property>
    <property name="actionOnEvent">(if (!get &quot;the-end&quot;)
  (delete-me))</property>
   </properties>
  </object>
