   <properties>
    <property name="action">(if (!get &quot;the-end&quot;)

(if (not (visited-room &quot;999&quot;))
  (if (!get &quot;001-talk-dad&quot;)
    (begin
      (dialog
        '((&quot;dad&quot; &quot;Here is our sleepyhead!\nFinally awake!\nThe hopes of the whole Kingdom are entrusted to you and you take it easy?&quot;)
        (&quot;/hero&quot; &quot;I'm a little late but what's the problem?\nThe important thing is to leave, isn't it?&quot;)
        (&quot;dad&quot; &quot;No! The important thing is to come back!\nThe 63 heroes before you didn't make it, but they weren't trained by a good father like me.&quot;)
        (&quot;/hero&quot; &quot;Do you think I'm ready?&quot;)
        (&quot;dad&quot; &quot;Absolutely not!\nBut today is Departure Day, what you have learned will have to be enough for you.\nIf you don't leave today, the Kings will send next year's hero on this journey.\nIt would be humiliating for the whole family and our town.&quot;)
        (&quot;/hero&quot; &quot;I know.\nNow… so… I'm leaving.&quot;)
        (&quot;dad&quot; &quot;Safe travels, {{hero}}.\nIf you lose your way or get stuck take a look at the map I gave you.\nYou can open it by tapping on its icon in the upper right corner.&quot;)
        (&quot;/hero&quot; &quot;Okay, sure sure.\nBye!&quot;)))
      (set &quot;001-talk-dad&quot; #t))
      (dialog '((&quot;dad&quot; &quot;The tower in which the King of Evil resides should be located near the capital of the region.&quot;))))
  (dialog '((&quot;dad&quot; &quot;Stay focused on your goals and don't wander around aimlessly.&quot;))))

(if (!get &quot;001-dad-end&quot;)
  (begin
    (set &quot;001-dad-end&quot; #t)
    (dialog
      '((&quot;dad&quot; &quot;Here is our sleepyhead hero!\nFinally awake!&quot;)
      (&quot;dad&quot; &quot;Do you still have nothing to do today?&quot;))))
  (dialog '((&quot;dad&quot; &quot;Do you still have nothing to do today?&quot;)))))</property>
