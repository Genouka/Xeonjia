  <object id="132" gid="229" x="64" y="144" width="16" height="16">
   <properties>
    <property name="action">(begin
  (set &quot;1-shen-end&quot; #t)
  (dialog
    '((&quot;/&quot; &quot;Here you are finally!\nI've been waiting for hours for you to wake up!\nHow are you?&quot;)
    (&quot;/hero&quot; &quot;I'm fine, even if I don't know what to do anymore.\nWhat does a hero do when there are no more villains?&quot;)
    (&quot;/&quot; &quot;I think it's time to dedicate yourself to something else.\nBut if you really want to explore this world again, I found out that there are 5 very rare stones hidden around the Kingdom.\nEach has a particular shape and color.&quot;)
    (&quot;/hero&quot; &quot;Rare stones?&quot;)
    (&quot;/&quot; &quot;Yes, I have no idea what they are for.\nTo be honest, I don't even know if they're worth looking for.\nIt's just to pass the time.&quot;)
