  <object id="29" gid="71" x="0" y="176" width="16" height="16">
   <properties>
    <property name="action">(begin
    (dialog
        '((&quot;/_1&quot; &quot;Mitsu Forest – Welcome, respect nature and remember to take a look at the souvenir shop on the right.&quot;)))
    (if (and (!get &quot;005-read&quot;) (!get &quot;the-end&quot;))
        (begin
            (dialog
                '((&quot;/hero&quot; &quot;Once this was a very touristy place, the Kingdom tried to make money from it.&quot;)))
            (set &quot;005-read&quot; #t))))</property>
