 <objectgroup id="9" name="npc">
  <object id="31" class="NPC" gid="150" x="80" y="32" width="16" height="16">
   <properties>
    <property name="action">(begin
  (dialog '((&quot;/&quot; &quot;Remember that hydration is essential for good overall health.&quot;)))
  (wait)
  (if (!get &quot;005-fresh-water&quot;)
    (begin
      (dialog '((&quot;/&quot; &quot;Here you go.&quot;)))
      (wait)
      (give-item &quot;fresh-water&quot;)
      (set &quot;005-fresh-water&quot; #t))))</property>
   </properties>
  </object>
  <object id="43" class="NPC" gid="135" x="208" y="80" width="16" height="16">
   <properties>
    <property name="action">(if (!get &quot;5-talk-botany&quot;)
  (begin
    (set &quot;5-talk-botany&quot; #t)
    (dialog '((&quot;student&quot; &quot;Ah, this forest is a true paradise for a botany enthusiast like me!&quot;)))
    (wait)
    (set-orientation 0)
    (dialog '((&quot;student&quot; &quot;Look at those plants!&quot;)))
    (wait)
    (set-orientation 1)
    (dialog '((&quot;student&quot; &quot;And have you seen those?!&quot;)))
    (wait)
    (set-orientation 2)
    (dialog '((&quot;student&quot; &quot;This one?&quot;)))
    (wait)
    (set-orientation 3)
    (dialog '((&quot;student&quot; &quot;And those!&quot;)))
    (wait)
    (set-orientation (opposite-orientation))
    (dialog '((&quot;student&quot; &quot;I love this place!&quot;)))
    (wait))
  (dialog '((&quot;student&quot; &quot;The trees of this region are admired and studied throughout the Kingdom.\nThese blue ones are my favorite.&quot;))))</property>
   </properties>
  </object>
 </objectgroup>
